# Canonical production origin. Drives metadataBase, canonical + hreflang
# tags, sitemap.xml, robots.txt and the JSON-LD @id/url fields.
#
# Write a real origin, with no angle brackets and no trailing slash:
#   NEXT_PUBLIC_SITE_URL=https://ravand.co
#
# A bare host also works (https:// is added for you):
#   NEXT_PUBLIC_SITE_URL=ravand.co
#
# This variable is OPTIONAL. On Vercel, the project's production domain is
# used automatically when it is unset or malformed, so a bad value can no
# longer fail the build (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://ravand.co

# --- Demo lead persistence (required for the /demo builder to work) ---
#
# Any standard Postgres connection string — Vercel Postgres, Neon,
# Supabase, RDS, or a self-hosted instance. See lib/db.ts.
DATABASE_URL=postgres://user:password@host:5432/ravand
# Set to "disable" only for a local/self-hosted Postgres with no TLS
# listener. Leave unset in production — managed Postgres requires TLS.
# PGSSLMODE=disable

# How long a private demo stays accessible after it's created. Any
# positive integer; defaults to 14 if unset. See lib/demo-token.ts.
DEMO_TRIAL_DAYS=14

# --- Lead notification: SMS to the RAVAND team, email as fallback ---
# See lib/notifications.ts. Every variable below is optional — with none
# set, a demo is still created and the customer still gets in; the team
# just isn't paged automatically.

# "kavenegar" is the only provider implemented today; the interface in
# lib/notifications.ts is written so another Iranian SMS provider can be
# added there without touching any call site. Leave unset (or "none") to
# skip SMS entirely.
SMS_PROVIDER=kavenegar
SMS_API_KEY=
# The approved sender line registered with the SMS provider.
SMS_SENDER_LINE=
# The RAVAND team's phone number that receives the lead SMS.
NOTIFY_MOBILE=

# SMTP fallback, used only when SMS is unset or fails. All five of these
# must be set together for email fallback to be attempted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# The RAVAND team's inbox that receives the fallback email.
NOTIFY_EMAIL=
