  "fragment": {
    "index": "01",
    "label": "Where most companies are",
    "title": "The business is one thing. Its systems aren't.",
    "body": "Most organizations run on separate tools: accounting in one application, sales in spreadsheets, stock in a ledger, and reporting somewhere in between. Every part holds its own data, and none of them show the whole picture.",
    "conclusion": "RAVAND puts those layers on one structure — without forcing the business to change how it works.",
    "caption": "Scattered, into structure"
  },
  "platform": {
    "index": "02",
    "label": "Platform",
    "title": "One platform, and the modules you choose",
    "lead": "Each module covers a defined area of the business and works on data shared with the rest. Your system only contains what you actually need.",
